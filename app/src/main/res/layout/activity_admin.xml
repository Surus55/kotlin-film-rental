<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Admin Panel"
            android:textSize="24sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnUsersList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Regisztrált Felhasználók"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnManageUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Regisztrált Felhasználók kezelése"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnManageFilms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filmek kezelése"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnViewRentals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kölcsönzések adatainak lekérdezése"
            android:layout_marginBottom="16dp"/>

        <!-- Új gomb: Admin kijelentkezés -->
        <Button
            android:id="@+id/btnLogoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kijelentkezés"
            android:layout_marginBottom="16dp"/>

        <FrameLayout
            android:id="@+id/fragment_container_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
