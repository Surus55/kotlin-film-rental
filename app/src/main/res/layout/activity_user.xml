<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="@string/user_panel_title"
            android:textSize="24sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnViewAvailableFilms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_available_films"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnViewMyRentals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_my_rentals"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnLogoutUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_logout"
            android:layout_marginBottom="16dp"/>

        <FrameLayout
            android:id="@+id/fragment_container_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
